<% content_for :page_title, "再ログイン" %>

<section class="account-panel panel" aria-labelledby="login-heading">
  <h1 id="login-heading" class="visually-hidden">ログイン</h1>
  <%= render "shared/account_tabs", active_tab: :login %>

  <% if @login_errors.present? %>
    <div class="account-errors" role="alert" aria-labelledby="login-errors-heading">
      <p id="login-errors-heading" class="account-errors__title">ログインできませんでした</p>
      <ul class="account-errors__list">
        <% @login_errors.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with url: login_path,
        scope: :session,
        method: :post,
        local: true,
        class: "account-form" do |form| %>
    <div class="account-field">
      <%= form.label :login_id, "ログインID", class: "account-field__label" %>
      <%= form.text_field :login_id,
            value: @login_id,
            required: true,
            autocomplete: "username",
            autocapitalize: "characters",
            spellcheck: false,
            class: "account-field__input" %>
    </div>

    <div class="account-field">
      <%= form.label :password, "パスワード", class: "account-field__label" %>
      <%= form.password_field :password,
            value: nil,
            required: true,
            autocomplete: "current-password",
            class: "account-field__input" %>
    </div>

    <div class="account-field">
      <%= form.label :nickname, "ニックネーム", class: "account-field__label" %>
      <%= form.text_field :nickname,
            value: @nickname,
            required: true,
            autocomplete: "nickname",
            placeholder: "例：しば",
            class: "account-field__input" %>
    </div>

    <div class="account-field">
      <%= form.label :job, "再び継続すること", class: "account-field__label" %>
      <%= form.text_field :job,
            value: @login_job,
            required: true,
            maxlength: SessionsController::TASK_JOB_MAX_LENGTH,
            autocomplete: "off",
            placeholder: "例：毎日30分プログラミングする",
            class: "account-field__input" %>
    </div>

    <%= form.submit "再ログインして続ける", class: "account-form__submit" %>
  <% end %>
</section>
