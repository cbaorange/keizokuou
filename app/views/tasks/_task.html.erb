<article class="task-item <%= "task-item--completed" if task[:done] %>" data-task-id="<%= task[:id] %>">
    <div class="task-item__status" aria-hidden="true">
        <svg
          class="task-item__check"
          viewBox="0 0 24 24"
          focusable="false"
          <%= "hidden" unless task[:done] %>
        >
          <path d="M5 12.5 9.5 17 19 7.5"></path>
        </svg>
    </div>

    <div class="task-item__content">
        <h3 class="task-item__title"><%=task[:job]%></h3>
        <p class="task-item__description"><%= task[:description] %></p>
    </div>

    <div>
        <h1 class="task_position_No" aria-hidden="true"><%=task[:position]%></h1>
    </div>
</article>
