<div class="modal-layer task-settings-layer" data-task-settings-modal hidden>
  <section
    class="task-settings-modal"
    role="dialog"
    aria-modal="true"
    aria-labelledby="task-settings-modal-heading"
  >
    <button
      type="button"
      class="task-settings-modal__close-button"
      aria-label="変更を保存せず閉じる"
      data-task-settings-close
    >×</button>

    <h2 id="task-settings-modal-heading" class="task-settings-modal__heading">
      タスク編集
    </h2>

    <form class="task-settings-modal__form" data-task-settings-form>
      <% (1..3).each do |position| %>
        <fieldset
          class="task-settings-modal__set"
          data-task-settings-position="<%= position %>"
        >
          <div class="task-settings-modal__field">
            <label
              class="task-settings-modal__label"
              for="task-settings-job-<%= position %>"
            >タスク</label>
            <div class="task-settings-modal__job-row">
              <input
                id="task-settings-job-<%= position %>"
                class="task-settings-modal__input"
                type="text"
                data-task-settings-job
              >
              <button
                type="button"
                class="task-settings-modal__delete-button"
                aria-label="position <%= position %>のタスクを削除"
                data-task-settings-delete
              >
                <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
                  <path d="M4 7h16M9 7V4h6v3M7 7l1 13h8l1-13M10 11v5M14 11v5"></path>
                </svg>
              </button>
            </div>
          </div>

          <div class="task-settings-modal__field">
            <label
              class="task-settings-modal__label"
              for="task-settings-description-<%= position %>"
            >詳細</label>
            <textarea
              id="task-settings-description-<%= position %>"
              class="task-settings-modal__input task-settings-modal__textarea"
              rows="1"
              data-task-settings-description
            ></textarea>
          </div>
        </fieldset>
      <% end %>

      <button type="submit" class="task-settings-modal__ok-button">OK</button>
    </form>
  </section>
</div>
