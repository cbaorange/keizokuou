<nav class="account-tabs" aria-label="アカウント画面">
  <%= link_to "新規登録",
        new_user_path,
        class: class_names(
          "account-tabs__link",
          "account-tabs__link--current": active_tab == :registration
        ),
        aria: (active_tab == :registration ? { current: "page" } : {}) %>
  <%= link_to "ログイン",
        login_path,
        class: class_names(
          "account-tabs__link",
          "account-tabs__link--current": active_tab == :login
        ),
        aria: (active_tab == :login ? { current: "page" } : {}) %>
</nav>
