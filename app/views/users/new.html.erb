<% content_for :page_title, "新規登録" %>

<section class="account-panel panel" aria-labelledby="registration-heading">
  <h1 id="registration-heading" class="visually-hidden">新規登録</h1>
  <%= render "shared/account_tabs", active_tab: :registration %>

  <% if @registration_errors.present? %>
    <div class="account-errors" role="alert" aria-labelledby="registration-errors-heading">
      <p id="registration-errors-heading" class="account-errors__title">入力内容を確認してください</p>
      <ul class="account-errors__list">
        <% @registration_errors.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with url: users_path,
        scope: :registration,
        method: :post,
        local: true,
        class: "account-form",
        data: { registration_form: true } do |form| %>
    <div class="account-field">
      <%= form.label :nickname, "ニックネーム", class: "account-field__label" %>
      <%= form.text_field :nickname,
            value: @nickname,
            required: true,
            autocomplete: "nickname",
            placeholder: "例：しば",
            class: "account-field__input" %>
    </div>

    <div class="account-field">
      <%= form.label :job, "継続すること", class: "account-field__label" %>
      <%= form.text_field :job,
            value: @registration_job,
            required: true,
            maxlength: UsersController::TASK_JOB_MAX_LENGTH,
            autocomplete: "off",
            placeholder: "例：毎日30分プログラミングする",
            class: "account-field__input" %>
    </div>

    <fieldset class="account-choice-group">
      <legend class="account-field__label">最も当てはまるもの</legend>
      <div class="account-choice-list">
        <% @registration_options.each do |option| %>
          <label class="account-choice">
            <%= form.radio_button :choice,
                  option.fetch(:value),
                  checked: @registration_choice == option.fetch(:value),
                  required: true,
                  class: "account-choice__input" %>
            <span class="account-choice__text">
              <span class="account-choice__label"><%= option.fetch(:label) %></span>
            </span>
          </label>
        <% end %>
      </div>
    </fieldset>

  <%= form.submit "新規登録して始める",
          class: "account-form__submit",
          data: { registration_submit: true } %>
  <% end %>
</section>
