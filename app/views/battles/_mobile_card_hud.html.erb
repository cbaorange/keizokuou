<div
  class="battle-mobile-card-hud"
  data-battle-mobile-hud
  data-team="<%= team %>"
  data-slot="<%= slot %>"
  data-card-id=""
  aria-hidden="false"
>
  <span class="battle-mobile-card-hud__level" data-role="mobile-level"></span>
  <div class="battle-mobile-card-hud__hp">
    <span class="battle-mobile-card-hud__hp-value" data-role="mobile-current-hp"></span>
    <div class="battle-mobile-card-hud__hp-bar" data-role="mobile-hp-bar" aria-label="現在HP">
      <span class="battle-mobile-card-hud__hp-current" data-role="mobile-hp-fill"></span>
    </div>
  </div>
</div>
